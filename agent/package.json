{
  "name": "@ghostcommit/agent",
  "version": "0.1.0",
  "description": "GhostCommit Desktop Agent",
  "main": "dist/main.js",
  "author": "GhostCommit",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "build": "tsc && electron-builder",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "start": "electron .",
    "compile": "tsc"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "chokidar": "^3.5.3",
    "simple-git": "^3.22.0",
    "node-machine-id": "^1.1.12",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@types/node": "^20.10.6",
    "electron": "^41.1.1",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.ghostcommit.agent",
    "productName": "GhostCommit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "assets/icon.png"
    }
  }
}
