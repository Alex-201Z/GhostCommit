# Database
DATABASE_URL="postgresql://ghostcommit:ghostcommit@localhost:5432/ghostcommit?schema=public"

# Application
NODE_ENV="development"
PORT=3000
API_URL="http://localhost:3000/api/v1"
DASHBOARD_URL="http://localhost:5173"
DASHBOARD_AUTH_SUCCESS_URL="http://localhost:5173/auth/callback"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_EXPIRES_IN="15m"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/v1/auth/github/callback"

# GitLab OAuth
GITLAB_CLIENT_ID="your-gitlab-client-id"
GITLAB_CLIENT_SECRET="your-gitlab-client-secret"
GITLAB_CALLBACK_URL="http://localhost:3000/api/v1/auth/gitlab/callback"

# LLM API (for summary generation)
# OpenAI
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4"

# Or Anthropic
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Redis (for BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Agent Configuration
AGENT_SYNC_INTERVAL=300000
AGENT_MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
